# ---- Runtime ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# Transactions (leave/employee/payroll) require a replica set. MongoDB Atlas
# provides one. For a standalone local Mongo, set TRANSACTIONS_ENABLED=false.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/hrms
TRANSACTIONS_ENABLED=true

# ---- Security secrets (REQUIRED) ----
# The application refuses to boot if these are missing, shorter than 32 chars,
# or identical to each other (SEC-2). Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=change_me_to_a_DIFFERENT_long_random_string_32
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d
BCRYPT_ROUNDS=10

# ---- CORS / frontend ----
FRONTEND_URL=http://localhost:3000

# ---- Rate limiting ----
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10

# ---- Email (optional) ----
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=HRMS <noreply@hrms.com>

# ---- Uploads ----
MAX_FILE_SIZE=10485760

# ---- Payroll statutory overrides (optional) ----
# TDS slab values are PLACEHOLDERS pending Finance sign-off.
PAYROLL_PF_RATE=0.12
PAYROLL_ESI_RATE=0.0075
PAYROLL_ESI_CEILING=21000
PAYROLL_OT_MULTIPLIER=1.5
